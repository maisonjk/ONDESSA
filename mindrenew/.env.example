# ---- Client (exposed to the browser; safe values only) ----
# Leave both blank to run in local mode: everything works, data stays in this browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Server only (Vercel env vars; never prefix with VITE_) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=
# Model for Truth Companion. Default claude-opus-5-5. claude-haiku-5-5 is ~40x cheaper per token.
COMPANION_MODEL=claude-opus-5-5

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=   # $7.99 / month
STRIPE_PRICE_ANNUAL=    # $59.99 / year
APP_URL=http://localhost:5173
